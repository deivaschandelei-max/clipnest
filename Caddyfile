{
email {$ACME_EMAIL}
}

{$CLIPNEST_DOMAIN} {
encode zstd gzip

request_body {
    max_size 16KB
}

reverse_proxy clipnest:3000 {
    flush_interval -1
}

header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
}

}
